# FleetCore production settings. Copy to .env.production, fill in every value and keep the file private:
#   cp .env.production.example .env.production && chmod 600 .env.production
# It is git-ignored. Docker Compose reads it for the compose file and passes it to the app, worker and beat.

# --- Release (scripts/update.sh changes this line) ---
FLEETCORE_VERSION=v1.0.0

# --- Application ---
APP_ENV=production
APP_DEBUG=false
# Public address of the web UI: used for the links inside email / Telegram reminders
APP_BASE_URL=https://fleet.example.com
# Departments offered in the vehicle form (JSON list), in addition to any already used
VEHICLE_DEPARTMENTS=[]
# Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"   (changing it logs everyone out)
SECRET_KEY=change-me

# --- Database (the password must be the same in all three places) ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://fleetcore:change-me@db:5432/fleetcore
DATABASE_URL_SYNC=postgresql+psycopg2://fleetcore:change-me@db:5432/fleetcore

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- File storage (MinIO). The access key and secret become the MinIO login ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-too-at-least-8-chars
MINIO_BUCKET=fleetcore
# MinIO inside Docker is plain http
MINIO_USE_SSL=false
# Address the BROWSER uses to download files (your reverse proxy in front of MinIO) and whether it uses HTTPS
MINIO_EXTERNAL_ENDPOINT=files.fleet.example.com
MINIO_EXTERNAL_USE_SSL=true

# --- Email reminders (leave SMTP_HOST empty to disable) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@fleet.example.com

# --- Telegram reminders (the bare token from @BotFather; leave empty to disable) ---
TELEGRAM_BOT_TOKEN=
